      "[fetch_abide_pcp] Dataset found in /home/evavi/abide-fmri/data/ABIDE_pcp\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Features shape : (871, 2016)\n",
      "871 sujets · 20 sites\n"
     ]
    }
   ],
   "source": [
    "data_dir   = os.environ.get('SOURCE_DATA_DIR', '../../data')\n",
    "output_dir = os.environ.get('OUTPUT_DATA_DIR', '../output')\n",
    "\n",
    "X, y = prepare_data_v2.prepare_data(data_dir, output_dir)\n",
    "X = np.array(X)\n",
    "y = np.array(y)\n",
    "\n",
    "abide  = datasets.fetch_abide_pcp(data_dir=data_dir, pipeline='cpac', quality_checked=True)\n",
    "pheno  = pd.DataFrame(abide.phenotypic)\n",
    "groups = [s.decode() if isinstance(s, bytes) else s for s in pheno.SITE_ID]\n",
    "\n",
    "print(f'Features shape : {X.shape}')\n",
    "print(f'{X.shape[0]} sujets · {len(set(groups))} sites')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d4e5f6g7",
   "metadata": {},
   "source": [
    "## Approche 1 — PCA avant CV (leakage)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e5f6g7h8",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-04-22T00:53:53.564608Z",
     "iopub.status.busy": "2026-04-22T00:53:53.564390Z",
     "iopub.status.idle": "2026-04-22T00:53:58.757068Z",
     "shell.execute_reply": "2026-04-22T00:53:58.751430Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dimensions après PCA : 571 composantes (variance expliquée >= 99%)\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Approche 1 — PCA avant CV (leakage)\n",
      "  Accuracy par fold : [0.605 0.686 0.667 0.582 0.72  0.528 0.676 0.696 0.651 0.547]\n",
      "  Moyenne           : 0.636\n",
      "  Écart-type        : 0.063\n"
     ]
    }
   ],
   "source": [
    "pca = PCA(0.99)\n",
    "X_pca = pca.fit_transform(X)\n",
    "\n",
    "print(f'Dimensions après PCA : {X_pca.shape[1]} composantes (variance expliquée >= 99%)')\n",
    "\n",
    "clf = LinearSVC(max_iter=10000)\n",
    "gkf = GroupKFold(n_splits=10)\n",
    "\n",
    "#ici j'ai remplacé la boucle du code original en utilisant cross_val_scores \n",
    "scores_leakage = cross_val_score(clf, X_pca, y, groups=groups, cv=gkf, n_jobs=-1) \n",
    "\n",
    "print(f'\\nApproche 1 — PCA avant CV (leakage)')\n",
    "print(f'  Accuracy par fold : {np.round(scores_leakage, 3)}')\n",
    "print(f'  Moyenne           : {scores_leakage.mean():.3f}')\n",
    "print(f'  Écart-type        : {scores_leakage.std():.3f}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f6g7h8i9",
   "metadata": {},
   "source": [
    "## Approche 2 — PCA dans le pipeline CV (corrigé)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "g7h8i9j0",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-04-22T00:53:58.764230Z",
     "iopub.status.busy": "2026-04-22T00:53:58.763527Z",
     "iopub.status.idle": "2026-04-22T00:54:03.659020Z",
     "shell.execute_reply": "2026-04-22T00:54:03.653582Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Approche 2 — PCA dans le pipeline CV (corrigé)\n",
      "  Accuracy par fold : [0.593 0.721 0.692 0.608 0.68  0.583 0.676 0.696 0.675 0.605]\n",
      "  Moyenne           : 0.653\n",
      "  Écart-type        : 0.047\n"
     ]
    }
   ],
   "source": [
    "pipeline = Pipeline([\n",
    "    ('pca', PCA(0.99)),\n",
    "    ('clf',    LinearSVC(max_iter=10000))\n",
    "])\n",
    "\n",
    "gkf = GroupKFold(n_splits=10)\n",
    "\n",
    "scores_corrected = cross_val_score(pipeline, X, y, groups=groups, cv=gkf, n_jobs=-1)\n",
    "\n",
    "print(f'Approche 2 — PCA dans le pipeline CV (corrigé)')\n",
    "print(f'  Accuracy par fold : {np.round(scores_corrected, 3)}')\n",
    "print(f'  Moyenne           : {scores_corrected.mean():.3f}')\n",
    "print(f'  Écart-type        : {scores_corrected.std():.3f}')"
   ]
  },
  {
